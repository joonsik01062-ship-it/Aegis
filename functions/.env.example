# 이 파일을 ".env"로 복사해서 값을 채우면 배포할 때 함께 적용된다. (.env는 git에 올리지 말 것)

# 내 계정만 쓰기: 허용할 구글 이메일을 쉼표로 적는다. 비워 두면 로그인한 누구나 사용 가능.
AEGIS_ALLOWED_EMAILS=내이메일@gmail.com

# 앱 검증(App Check)을 강제한다. README의 App Check 설정을 끝낸 뒤에 true로 바꾼다.
AEGIS_ENFORCE_APPCHECK=false

# 직접 연결한 도메인이 있다면 추가 (기본 *.web.app, *.firebaseapp.com은 자동 허용)
# AEGIS_ALLOWED_ORIGINS=https://내도메인.com

# 모델 바꾸기 (선택)
# AEGIS_MODEL_BASIC=claude-sonnet-5-5
# AEGIS_MODEL_MASTER=claude-opus-5-5

# 마스터 웹 검색 끄기 (선택)
# AEGIS_WEB_SEARCH=false
